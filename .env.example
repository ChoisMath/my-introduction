# 로컬 개발 (web/.env.local 로 복사)
# npm start(standalone)는 server.js 폴더로 chdir 하므로 절대경로여야 한다. 상대경로는 npm run dev 에서만 동작.
RAILWAY_VOLUME_MOUNT_PATH=../.local-volume
AUTH_SECRET=
# 운영은 https://me.chois.pro (없으면 Auth.js 가 내부 주소 0.0.0.0:8080 으로 URL 을 만든다). 로컬은 비워 둔다.
AUTH_URL=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
ADMIN_EMAILS=
MEDIA_UPLOAD_TOKEN=
# 로컬 스크립트 전용
MOTION_SRC=/Volumes/Chois_SD2/dev/motion
MEDIA_PUSH_URL=http://localhost:3000
