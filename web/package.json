{
  "name": "web",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "prisma generate && tsx ../scripts/gen-tokens-css.ts",
    "dev": "next dev",
    "prebuild": "prisma generate && tsx ../scripts/gen-tokens-css.ts",
    "build": "next build",
    "postbuild": "node ../scripts/copy-standalone-assets.mjs",
    "start": "node .next/standalone/web/server.js",
    "lint": "eslint .",
    "typecheck": "prisma generate && tsx ../scripts/gen-tokens-css.ts && tsc --noEmit",
    "e2e": "playwright test",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy"
  },
  "dependencies": {
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@me/content": "*",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "motion": "14.0.0",
    "next": "16.4.0",
    "next-auth": "5.0.0-beta.32",
    "pg": "8.23.1",
    "pretendard": "1.3.9",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.13.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "prisma": "7.10.0",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "6.0.3"
  }
}
